# ==============================================================================
# 🏛️ AI GOVCOREX OS — MASTER ENVIRONMENT CONFIGURATION
# Autonomous Agentic Compliance OS for the Public Sector
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MATRIZ / PORTAL INSTITUCIONAL (frontend/portal)
# ------------------------------------------------------------------------------
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://aigovcorex.com
NEXT_PUBLIC_SITE_NAME="AI GovCoreX"

# VIP Beta Lead Ingestion & Webhooks (Telegram / Discord / Make / CRM)
LEADS_WEBHOOK_URL=
NOTIFICATION_EMAIL=contact@aigovcorex.com
ADMIN_API_KEY=

# ------------------------------------------------------------------------------
# 2. DASHBOARD DE PROGRAMAS SOCIALES (frontend/dashboard)
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:9002

# ------------------------------------------------------------------------------
# 3. BACKEND PYTHON & IA AGÉNTICA (backend/modules/early-childhood)
# ------------------------------------------------------------------------------
FLASK_APP=app.py
FLASK_ENV=production
SECRET_KEY=change-this-to-a-super-secret-key-in-production

# Base de Datos Relacional Multi-Tenant (MySQL / MariaDB / PostgreSQL)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=kindicore_db
DB_PORT=3306

# Modelos de Lenguaje & Proveedores de IA
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Motor Vectorial RAG (Normativas MIES, OMS, Guías Estatales)
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX_NAME=kindicore-norms

# Servicio de Transcripción de Voz a Texto
WHISPER_MODEL=faster-whisper
WHISPER_DEVICE=cpu

# ------------------------------------------------------------------------------
# 4. SERVICIO DE INGESTA DE VOZ WHATSAPP (services/whatsapp-voice)
# ------------------------------------------------------------------------------
WHATSAPP_PORT=3001
WHATSAPP_SESSION_NAME=aigovcorex-voice-bot
WHATSAPP_BACKEND_URL=http://localhost:5000/api/whatsapp-webhook
