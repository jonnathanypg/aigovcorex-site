{
  "name": "aigovcorex-os",
  "version": "2.0.0",
  "private": true,
  "description": "AI GovCoreX - Autonomous Agentic Compliance OS for the Public Sector",
  "scripts": {
    "dev": "npm run dev:portal",
    "dev:portal": "npm --prefix frontend/portal run dev",
    "dev:dashboard": "npm --prefix frontend/dashboard run dev",
    "dev:whatsapp": "npm --prefix services/whatsapp-voice run dev",
    "build:portal": "npm --prefix frontend/portal run build",
    "build:dashboard": "npm --prefix frontend/dashboard run build",
    "build:all": "npm run build:portal && npm run build:dashboard",
    "lint:portal": "npm --prefix frontend/portal run lint",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:logs": "pm2 logs"
  },
  "keywords": [
    "govtech",
    "regtech",
    "agentic-ai",
    "langgraph",
    "compliance",
    "public-sector",
    "early-childhood"
  ],
  "author": "WebLifeTech",
  "license": "UNLICENSED"
}
